[Unit]
Description=Fortify Node (Healthy)
After=network.target tor.service
Requires=tor.service

[Service]
Type=simple
User=fortify
Group=fortify
Environment="NODE_MODE=healthy"
ExecStart=/opt/fortify/bin/fortify-node
Restart=on-failure
RestartSec=5s

# Security hardening
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log/fortify /var/run/fortify
NoNewPrivileges=yes
PrivateNetwork=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=1G
CPUQuota=150%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fortify-node-healthy

[Install]
WantedBy=multi-user.target
