[Unit]
Description=Fortify Controller
After=network.target tor.service
Requires=tor.service

[Service]
Type=simple
User=fortify
Group=fortify
ExecStart=/opt/fortify/bin/fortify-controller
Restart=on-failure
RestartSec=10s

# Security hardening
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log/fortify /var/run/fortify
NoNewPrivileges=yes
PrivateNetwork=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fortify-controller

[Install]
WantedBy=multi-user.target
